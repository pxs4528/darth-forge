# VPS production environment. Copy to .env.vps on the server and fill in.
#
#   scp .env.vps.example you@vps:~/darth-forge/.env.vps
#
# Never commit .env.vps — it holds the admin password and, once Plaid is live,
# the tokens that read your bank accounts.

# ── hostnames ────────────────────────────────────────────────────────────────
# Both must already resolve to this VPS before the stack starts: Caddy fetches
# Let's Encrypt certificates on boot and fails loudly if DNS isn't ready.
SITE_DOMAIN=example.com
BUDGET_DOMAIN=budget.example.com

# Tailscale IP for budget access. Get it from the VPS after joining Tailscale:
#   tailscale ip -4
TAILSCALE_IP=100.67.171.24

# Where Let's Encrypt sends expiry warnings.
ACME_EMAIL=you@example.com

# ── internal wiring (leave as-is) ────────────────────────────────────────────
API_HOST=backend
API_PORT=8080
INFOSEC_HOST=infosec
INFOSEC_PORT=5000

# ── admin ────────────────────────────────────────────────────────────────────
# Guards /budget and the terminal's `sudo`. This is now the only thing between
# the internet and your ledger, so make it long and unique.
#   openssl rand -base64 32
ADMIN_SECRET=

# ── budget database (Turso) ──────────────────────────────────────────────────
# Reuse the same database the Pi used — the data moves with the credentials,
# not with the machine. If unset the site still runs and budget routes 503.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Read-only token for backup pulls (GET /api/admin/budget/dump).
#   openssl rand -hex 24
BACKUP_TOKEN=

# ── Plaid (optional) ─────────────────────────────────────────────────────────
# Leave empty until you have keys; the Banks tab reports itself unavailable.
# See docs/budget.md for setup and docs/budget-todo.md for what's outstanding.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# Don't import transactions dated before this (YYYY-MM-DD). Plaid backfills up
# to 24 months on the first sync; anything before the book was opened is already
# inside the opening balances, so importing it double-counts and buries the
# rows worth reviewing. Set this to the date you opened the book. Leave empty
# to import everything Plaid offers.
PLAID_IMPORT_START=

# ── USCIS poller ─────────────────────────────────────────────────────────────
USCIS_CASE_URL=
USCIS_COOKIE=
USCIS_BEARER=

# ── ntfy push ────────────────────────────────────────────────────────────────
NTFY_TOPIC=
NTFY_TOKEN=
