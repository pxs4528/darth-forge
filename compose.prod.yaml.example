# Docker Compose Production Configuration
# Copy this file to compose.prod.yaml (and keep it in sync when this example changes)
#
# Prod pulls prebuilt multi-arch images from GHCR — the Pi never builds.
# Images are published by .github/workflows/deploy.yml on every push to main.
# If the GHCR packages are private, log in once on the Pi:
#   echo <PAT-with-read:packages> | docker login ghcr.io -u pxs4528 --password-stdin
#
# Usage: docker compose -f compose.yaml -f compose.prod.yaml up -d --no-build

version: '3.8'

services:
  frontend:
    image: ghcr.io/pxs4528/darth-forge-frontend:latest
    # Override the base file's .env.dev — prod must read .env.prod
    env_file:
      - .env.prod
    environment:
      - DOMAIN=${DOMAIN}

  backend:
    image: ghcr.io/pxs4528/darth-forge-backend:latest
    env_file:
      - .env.prod
    environment:
      - ENV=production
    restart: unless-stopped

  infosec:
    image: ghcr.io/pxs4528/darth-forge-infosec:latest
