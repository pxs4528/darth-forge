# Example Environment Variables
# Copy this file to .env.dev for development or .env.prod for production

# Domain (for production)
DOMAIN=your-domain.com

# API Configuration
API_HOST=backend
API_PORT=8080

# ── Admin ─────────────────────────────────────────────────────────────────────
# Secret password for the admin panel (terminal: sudo <password>) and /budget
ADMIN_SECRET=change-me-to-something-strong

# ── Budget Tool (Turso) ──────────────────────────────────────────────────────
# The /budget page stores data in Turso (SQLite-over-HTTP, free tier).
# One-time setup:
#   1. Install the CLI:      curl -sSfL https://get.tur.so/install.sh | bash
#   2. Sign up (GitHub SSO): turso auth signup
#   3. Create the database:  turso db create darth-budget
#   4. Get the URL:          turso db show darth-budget --url
#   5. Mint a token:         turso db tokens create darth-budget
# Tables are created automatically on first boot. If unset, the site still
# runs — budget API routes just return 503.
TURSO_DATABASE_URL=libsql://darth-budget-<yourname>.turso.io
TURSO_AUTH_TOKEN=

# Read-only token for automated backup pulls (GET /api/admin/budget/dump).
# Separate from ADMIN_SECRET so remote machines never store the admin
# password. Generate: openssl rand -hex 24
BACKUP_TOKEN=

# ── Plaid (bank sync, optional) ──────────────────────────────────────────────
# Links your banks so transactions import instead of being typed. If unset,
# the budget tool works exactly as before and the /plaid routes return 503.
#
# Setup:
#   1. Sign up at https://dashboard.plaid.com/signup (free)
#   2. Team Settings -> Keys: copy client_id and the Sandbox secret
#   3. To use real banks, apply for the free Trial plan (10 live Items,
#      no time limit, includes Chase/Capital One OAuth). The Production
#      secret appears once approved.
#
# Start with PLAID_ENV=sandbox and the sandbox secret: Link then accepts the
# test login user_good / pass_good, so the whole flow can be exercised
# against fake data before pointing it at real accounts.
PLAID_CLIENT_ID=
PLAID_SECRET=
# sandbox | production   (Plaid retired "development" in 2024)
PLAID_ENV=sandbox

# Don't import transactions dated before this (YYYY-MM-DD). Plaid backfills up
# to 24 months on the first sync; anything predating the book is already in the
# opening balances. Set to the date the book was opened; empty imports all.
PLAID_IMPORT_START=

# ── USCIS Poller ─────────────────────────────────────────────────────────────
# Override the default case URL (optional)
USCIS_CASE_URL=https://my.uscis.gov/account/case-service/api/cases/IOE9856492653

# Session credentials — capture from browser DevTools after logging into my.uscis.gov:
#   1. Open DevTools → Network tab
#   2. Navigate to your case (the URL above)
#   3. Find the XHR request and copy the Cookie header value
# These can also be updated live via the admin panel (PUT /api/admin/uscis/credentials)
USCIS_COOKIE=
USCIS_BEARER=

# ── ntfy.sh Push Notifications ───────────────────────────────────────────────
# 1. Install the "ntfy" app on your phone (iOS / Android)
# 2. Create a private topic at https://ntfy.sh (e.g. uscis-updates-abc123)
# 3. Subscribe to that topic in the app
# 4. Set NTFY_TOPIC below — backend will POST here on every status change
NTFY_TOPIC=
# Optional: ntfy access token if your topic is access-controlled
NTFY_TOKEN=
